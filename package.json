{
  "name": "@sell.app/sdk",
  "version": "0.1.1",
  "description": "Official TypeScript and JavaScript SDK for SellApp products, orders, customers, and subscriptions.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE.txt",
    "NOTICE.txt"
  ],
  "license": "MIT",
  "homepage": "https://sell.app/docs/api/sdks",
  "bugs": {
    "url": "https://github.com/sellapp/sellapp-node/issues"
  },
  "keywords": [
    "sellapp",
    "sdk",
    "typescript",
    "javascript",
    "ecommerce"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sellapp/sellapp-node.git"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --format esm,cjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "^0.21.5",
    "typescript": "^5.9.0"
  }
}
