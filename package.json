{
  "name": "sellapp",
  "version": "0.1.0",
  "description": "SellApp API Node.js SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE.txt",
    "NOTICE.txt"
  ],
  "license": "MIT",
  "homepage": "https://sell.app/docs/api",
  "repository": {
    "type": "git",
    "url": "https://github.com/sellapp/sellapp-node.git"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --format esm,cjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "^0.21.5",
    "typescript": "^5.9.0"
  }
}
